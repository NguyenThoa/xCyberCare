# =====================================================================
# Mẫu cấu hình môi trường test xCare — copy thành .env rồi điền giá trị.
# File .env đã nằm trong .gitignore. KHÔNG điền giá trị thật vào file mẫu này.
# =====================================================================

# --- Môi trường ---
# URL trang đăng nhập / trang chủ của môi trường TEST (không dùng production)
XCARE_BASE_URL=
# Tên môi trường để ghi vào report, VD: UAT, STAGING
XCARE_ENV_NAME=

# --- Tài khoản 1: đơn vị chính (dùng cho luồng tạo thủ tục 607) ---
XCARE_USER1_USERNAME=
XCARE_USER1_PASSWORD=
# Mã hoặc tên đơn vị của tài khoản 1 (để đối chiếu dữ liệu đúng đơn vị)
XCARE_USER1_UNIT=

# --- Tài khoản 2: đơn vị KHÁC (kiểm "chỉ dùng tính năng của đơn vị mình") ---
# Tài khoản này chỉ dùng để ĐĂNG NHẬP XEM dữ liệu (không ký được).
# Để trống nếu chưa có — các ca phân quyền sẽ bị BLOCKED
XCARE_USER2_USERNAME=
XCARE_USER2_PASSWORD=
XCARE_USER2_UNIT=

# --- Ký số (nút Trình ký / Ký và gửi) ---
# Chỉ đơn vị của tài khoản 1 ký được. Không cần điền nếu ký bằng chính tài khoản 1.
# Cách ký trên môi trường test, VD: USB token / ký số từ xa / tài khoản ký riêng
XCARE_SIGN_METHOD=
# Điền nếu ký số cần tài khoản/PIN riêng; để trống nếu không cần
XCARE_SIGN_USERNAME=
XCARE_SIGN_PIN=
# Xác nhận môi trường này gửi tới cổng BHXH THỬ NGHIỆM: yes / no
# Khác "yes" → agent KHÔNG bấm "Ký và gửi"
XCARE_BHXH_SANDBOX_CONFIRMED=no
